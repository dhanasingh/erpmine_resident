<%= form_tag({}, method: :get, id: 'query_form') do %>
	<%= hidden_field_tag "searchlist", controller_name %>
	<%
		locationId = session[controller_name].try(:[], :location_id)
	%>
	<fieldset>
		<div style="display: flex; align-items: center; gap: 10px;padding-top: 5px; flex-wrap: wrap;">
			<%= l(:field_location) %>
			<%= select_tag("location_id",generic_options_for_select(
					WkLocation, nil, 'name', 'name', 'id', locationId, true ) ) %>
			<%= render :partial => 'wktime/date_range' %>
			<%= submit_tag l(:button_apply), :class => 'button-small', :name => 'submit' %>
			<%= link_to sprite_icon('reload', l(:button_clear)), {tab: controller_name, clear: true}, :class => 'icon icon-reload' %>
		</div>
	</fieldset>
<% end %>
<%=  %>